<% layout('layouts/boilerplate.ejs') %>
<body>
  <div class="row">
    <div class="col-8 offset-3">
      <h3 class="listing-main-header"><%= listing.title %></h3>

      <div class="card listing-card show-card col-8">
        <img src="<%= listing.image %>" class="card-img-top show-img" alt="Listing image">
        <div class="card-body mt-2">
          <p class="card-text mb-2">Owned by <i><%= listing.owner.username %></i>.</p>
          <p class="card-text listing-description"><%= listing.description %></p>
          <p class="card-text listing-price">$<%= listing.price.toLocaleString('en-US') %> / night</p>
          <p class="card-text"><%= listing.location %>, <%= listing.country %>.</p>
        </div>
      </div>

      <% if (currentUser && currentUser._id.equals(listing.owner._id)) { %>
        <form class="edit-btn-link" method="GET" action="/listings/<%= listing.id %>/edit">
          <button class="btn custom-btn" type="submit">Edit</button>
        </form>

        <form class="delete-btn-link ms-1" method="POST" action="/listings/<%= listing.id %>?_method=DELETE">
          <button class="btn btn-dark" type="submit">Delete</button>
        </form>
      <% } %>

      <hr>
      
      <% if (listing.reviews.length) { %>
        <h4>All Reviews</h4>
        <div class="row mt-3">
          <% for (let review of listing.reviews) { %>
            <div class="card review-card col-5 ms-3">
              <div class="card-body">
                <h5 class="card-title">@<%= review.author.username %></h5>
                <p class="card-text"><%= review.comment %></p>
                <p class="card-text"><span style="font-size: 1.15rem"><b><%= review.rating %></b></span> / 5</p>
              </div>
              
              <% if (currentUser && currentUser._id.equals(review.author._id)) { %>
                <form class="mt-3" method="POST" action="/listings/<%= listing.id %>/reviews/<%= review.id %>?_method=DELETE">
                  <button class="btn btn-dark" type="submit">Delete</button>
                </form>
              <% } %>
            </div>
          <% } %>
        </div>

        <hr>
      <% } %>
        
      <% if (currentUser) { %>
        <form novalidate class="needs-validation mt-3 mb-3" method="POST" action="/listings/<%= listing.id %>/reviews">
          <h4>Leave a review</h4>

          <div class="mt-3 mb-3">
            <label class="mb-1 form-label" for="rating">Rating</label>
            <input class="form-range" type="range" min="1" max="5" id="rating" name="review[rating]">
          </div>
          <div class="mt-3 mb-3">
            <label class="mb-1 form-label" for="comment">Comment</label>
            <textarea class="form-control" id="comment" name="review[comment]" rows="4" required></textarea>
            <div class="invalid-feedback">
              Please add a comment.
            </div>
          </div>

          <button class="btn btn-outline-dark">Submit</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
