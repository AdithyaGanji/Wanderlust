<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <title>Wandlerlust</title>
</head>

<body>
  <h3>Listing Details</h3>

  <ul>
    <li>
      <%= listing.title %>
    </li>
    <li>
      <%= listing.description %>
    </li>
    <li>$<%= listing.price.toLocaleString('en-US') %>
    </li>
    <li>
      <%= listing.location %>
    </li>
    <li>
      <%= listing.country %>
    </li>
  </ul>
  <hr>

  <a href="/listings/edit/<%= listing.id %>">Edit this Listing</a>
</body>

</html>