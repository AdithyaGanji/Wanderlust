    <div class="tax-switch">
      <div class="form-check form-switch form-check-reverse">
        <input class="form-check-input" type="checkbox" id="switchCheckReverse">
        <label class="form-check-label" for="switchCheckReverse">Display total after taxes</label>
      </div>
    </div>
   </div>
  
  <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-2 row-cols-xs-1">
    <% if (!listings.length) { %>
      <h2 class="no-listings-text">No listings found.</h2>
    <% } %>

    <% for (let listing of listings) { %>
      <a class="listing-link" href="/listings/<%= listing.id %>">
          <div class="card listing-card">
            <div class="card-img-overlay"></div>
            <img src="<%= listing.image.url %>" class="card-img-top" alt="Image of a listing.">
            <div class="card-body">
              <p class="card-text listing-title"><b><%= listing.title %></b></p>
              <p class="card-text listing-price">
                <span class="price-before-tax">
                  $<%= listing.price.toLocaleString('en-US') %>
                </span>
                <span style="display: none" class="price-after-tax">
                  $<%= Math.ceil(((Number(listing.price) + (Number(listing.price) * 0.1)))).toLocaleString('en-US')  %>
                </span>
                / night
              </p>  
            </div>
          </div>
      </a>
    <% } %>
  </div>

  <script>
    const taxSwitcher = document.getElementById("switchCheckReverse")
    const priceBeforeTax = document.querySelectorAll('.price-before-tax')
    const priceAfterTax = document.querySelectorAll('.price-after-tax')

    taxSwitcher.addEventListener('click', () => {
      priceBeforeTax.forEach((element) => {
        element.style.display = (element.style.display === 'none') ? 'initial' : 'none'
      })
      
      priceAfterTax.forEach((element) => {
        element.style.display = (element.style.display === 'none') ? 'initial' : 'none'
      })
    })
  </script>
</body>
