<% layout('layouts/boilerplate.ejs') %>
<body>
  <h3 class="listing-main-header">All Listings</h3>
  
  <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-2 row-cols-xs-1">
    <% for (let listing of listings) { %>
      <a class="listing-link" href="/listings/<%= listing.id %>">
          <div class="card listing-card">
            <div class="card-img-overlay"></div>
            <img src="<%= listing.image %>" class="card-img-top" alt="Image of a listing.">
            <div class="card-body">
              <p class="card-text listing-title"><b><%= listing.title %></b></p>
              <p class="card-text listing-price">$<%= listing.price.toLocaleString('en-US') %> / night</p>  
            </div>
          </div>
      </a>
    <% } %>
  </div>

  <hr>
</body>
