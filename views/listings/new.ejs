<% layout('layouts/boilerplate.ejs') %>
  <body>
    <div class="row">
      <div class="col-8 offset-2">
        <h3 class="listing-main-header">Create New Listing</h3>

        <form enctype="multipart/form-data" class="needs-validation" method="POST" action="/listings" novalidate>
          <div class="mb-3">
            <label class="form-label" for="title">Title</label>
            <input id="title" class="form-control" type="text" name="listing[title]" autofocus autocomplete="off" placeholder="Add a title"
              required>
            <div class="valid-feedback">
              Title looks good!
            </div>
            <div class="invalid-feedback">
              Please enter a title.
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="description">Description</label>
            <textarea id="description" class="form-control" name="listing[description]" required placeholder="Add a description"></textarea>
            <div class="valid-feedback">
              Description looks good!
            </div>
            <div class="invalid-feedback">
              Please enter a description.
            </div>
          </div>

          <div class="mb-3">
            <label for="formFile" class="form-label">Upload Listing Image</label>
            <input name="listing[image]" class="form-control" type="file" id="formFile" required>
            <div class="invalid-feedback">
              Please upload an image of the listing.
            </div>
          </div>

          <div class="row mt-3 mb-1">
            <div class="col-md-4 mb-3">
              <label for="category" class="form-label">Category</label>
              <select class="form-select" name="listing[category]" id="category" required>
                <option selected disabled value="">Choose...</option>
                <option value="hotels">Hotel</option>
                <option value="cities">City</option>
                <option value="mountains">Mountain</option>
                <option value="castles">Castle</option>
                <option value="pools">Pool</option>
                <option value="farms">Farm</option>
                <option value="arctic">Arctic</option>
                <option value="beaches">Beach</option>
              </select>
              <div class="invalid-feedback">
                Please choose a valid category.
              </div>
            </div>
            <div class="col-md-8 mb-3">
              <label class="form-label" for="price">Price</label>
              <input id="price" class="form-control" type="number" name="listing[price]" placeholder="Ex. 250"
                autocomplete="off" required>
              <div class="invalid-feedback">
                Please enter a valid price.
              </div>
            </div>
          </div>

          <div class="row mt-1 mb-1">
            <div class="col-md-4 mb-3">
              <label class="form-label" for="location">Location</label>
              <input id="location" class="form-control" type="text" name="listing[location]" placeholder="Ex. New York"
                autocomplete="off" required>
              <div class="invalid-feedback">
                Please enter a valid location.
              </div>
            </div>
            <div class="col-md-8 mb-3">
              <label class="form-label" for="country">Country</label>
              <input id="country" class="form-control" type="text" name="listing[country]" placeholder="Ex. United States"
                autocomplete="off" required>
              <div class="invalid-feedback">
                Please enter a valid country.
              </div>
            </div>
          </div>

          <button class="btn custom-btn" type="submit">Create Listing</button>
        </form>
      </div>
    </div>
  </body>
