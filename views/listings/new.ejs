<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <title>Wandlerlust - New Listing</title>
</head>

<body>
  <h3>Create a New Listing</h3>

  <form method="POST" action="/listings">
    <input type="text" name="listing[title]" placeholder="Enter title" autofocus autocomplete="off" required>
    <br><br>

    <textarea name="listing[description]" placeholder="Enter description"></textarea>
    <br><br>

    <input type="text" name="listing[image]" placeholder="Enter image URL" autocomplete="off">
    <br><br>

    <input type="number" name="listing[price]" placeholder="Enter price" autocomplete="off" required>
    <br><br>

    <input type="text" name="listing[location]" placeholder="Enter location" autocomplete="off" required>
    <br><br>

    <input type="text" name="listing[country]" placeholder="Enter country" autocomplete="off" required>
    <br><br>

    <button type="submit">Create Listing</button>
  </form>
</body>

</html>