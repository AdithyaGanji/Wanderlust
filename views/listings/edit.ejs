<% layout('layouts/boilerplate.ejs') %>
<body>
  <div class="form-listing-edit mb-4">
    <h3 class="listing-page-header">Edit Listing</h3>

    <form enctype="multipart/form-data" class="needs-validation" method="POST" action="/listings/<%= listing.id %>/edit?_method=PUT" novalidate>
      <div class="mb-3">
        <label class="form-label" for="title">Title</label>
        <input id="title" class="form-control" type="text" name="listing[title]" value="<%= listing.title %>" autocomplete="off" required>
        <div class="invalid-feedback">
          Please enter a title.
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="description">Description</label>
        <textarea id="description" class="form-control" name="listing[description]" autocomplete="off" required><%= listing.description %></textarea>
        <div class="invalid-feedback">
          Please enter a description.
        </div>
      </div>

      <div class="mb-3">
        <label for="formFile" class="form-label">Upload Listing Image</label>
        <input name="listing[image]" class="form-control" type="file" id="formFile">
      </div>

      <div>
        <p class="d-inline-flex gap-1">
          <button class="btn btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample" aria-expanded="false" aria-controls="collapseExample">
            View Original Image
          </button>
        </p>
        <div class="mb-3 collapse" id="collapseExample">
          <img class="listing-image-preview" src="<%= originalListingURL %>" alt="Original Listing Image">
        </div>
      </div>

      <div class="row mt-3 mb-1">
        <div class="col-md-4 mb-3">
          <label for="category" class="form-label">Category</label>
          <select class="form-select" name="listing[category]" id="category" required>
            <option <%= listing.category === 'hotels' ? 'selected' : '' %> value="hotels">Hotel</option>
            <option <%= listing.category === 'cities' ? 'selected' : '' %> value="cities">City</option>
            <option <%= listing.category === 'mountains' ? 'selected' : '' %> value="mountains">Mountain</option>
            <option <%= listing.category === 'castles' ? 'selected' : '' %> value="castles">Castle</option>
            <option <%= listing.category === 'pools' ? 'selected' : '' %> value="pools">Pool</option>
            <option <%= listing.category === 'farms' ? 'selected' : '' %> value="farms">Farm</option>
            <option <%= listing.category === 'arctic' ? 'selected' : '' %> value="arctic">Arctic</option>
            <option <%= listing.category === 'beach' ? 'selected' : '' %> value="beaches">Beach</option>
          </select>
          <div class="invalid-feedback">
            Please choose a valid category.
          </div>
        </div>
        <div class="col-md-8 mb-3">
          <label class="form-label" for="price">Price</label>
          <input id="price" class="form-control" type="number" name="listing[price]" value="<%= listing.price %>" autocomplete="off" required>
          <div class="invalid-feedback">
            Please enter a valid price.
          </div>
        </div>
      </div>

      <div class="row mt-1 mb-1">
        <div class="col-md-4 mb-3">
          <label class="form-label" for="location">Location</label>
          <input id="location" class="form-control" type="text" name="listing[location]" value="<%= listing.location %>" autocomplete="off" required>
          <div class="invalid-feedback">
            Please enter a valid location.
          </div>
        </div>

        <div class="col-md-8 mb-3">
          <label class="form-label" for="country">Country</label>
          <input id="country" class="form-control" type="text" name="listing[country]" value="<%= listing.country %>" autocomplete="off" required>
          <div class="invalid-feedback">
            Please enter a valid country.
          </div>
        </div>
      </div>

      <button class="mb-3 btn btn-brand-primary" type="submit">Edit Listing</button>
    </form>
  </div>
</body>
